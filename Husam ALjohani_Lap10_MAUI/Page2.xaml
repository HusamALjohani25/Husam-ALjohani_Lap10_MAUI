<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Husam_ALjohani_Lap10_MAUI.Page2"
  Title="MyCart">

    <Grid Padding="16"
          RowDefinitions="*,Auto,Auto"
          RowSpacing="12">
        <ListView Grid.Row="0"
                  x:Name="myListView"
                  HasUnevenRows="True"
                  SelectionMode="None"
                  HorizontalOptions="Fill">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame Margin="0,8"
                               Padding="14"
                               CornerRadius="14"
                               HasShadow="False"
                               BackgroundColor="#1E2530"
                               BorderColor="#334155">
                            <Grid ColumnDefinitions="115,*"
                                  ColumnSpacing="14"
                                  VerticalOptions="Center">
                                <Image Grid.Column="0"
                                       Source="{Binding ImageUrl}"
                                       HeightRequest="145"
                                       WidthRequest="105"
                                       Aspect="AspectFill"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="8"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White" />

                                    <Label Text="{Binding Price, StringFormat='{0} SR'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#F87171" />

                                    <Label Text="{Binding info}"
                                           FontSize="13"
                                           TextColor="#4ADE80"
                                           LineBreakMode="WordWrap" />

                                    <HorizontalStackLayout Spacing="12"
                                                           VerticalOptions="Center"
                                                           Margin="0,4,0,0">
                                        <Label FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               VerticalOptions="Center"
                                               Text="{Binding Source={x:Reference _stepper}, Path=Value, StringFormat='Quantity {0}'}" />
                                        <Stepper x:Name="_stepper"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Increment="1"
                                                 Value="{Binding Quantity}"
                                                 VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="1"
                Text="buy"
                Clicked="Button_Clicked_1"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontSize="17"
                FontAttributes="Bold"
                HeightRequest="48"
                CornerRadius="16" />

        <Button Grid.Row="2"
                Text="Back to Shop"
                Clicked="Button_Clicked"
                BackgroundColor="#334155"
                TextColor="White"
                FontSize="15"
                HeightRequest="44"
                CornerRadius="14" />
    </Grid>
</ContentPage>


